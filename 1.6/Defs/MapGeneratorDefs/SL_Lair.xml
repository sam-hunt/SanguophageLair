<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    SL_Lair: the pocket-map generator behind SL_AncientStairwell's portal.

    SCAFFOLD. Today this is a bare underground cave: Odyssey InsectLair's genstep skeleton
    minus its insect content and ruins scatter, so the portal is traversable end-to-end while
    the real lair subtree (custom GenSteps, layout defs) is built. Every def referenced here
    is Core-owned (verified against Data/ - no Odyssey/Anomaly dependency).

    SL_PlaceStairwellExit (1.6/Defs/GenStepDefs/PlaceStairwellExit.xml) stands where vanilla
    PlaceCaveExit would: it spawns the generating portal's exitDef (SL_AncientStairwellExit)
    in the entrance's stuff and sets PlayerStartSpot, so the portal already round-trips with
    the real two-layer stairwell at both ends while the rest of the lair is scaffold.

    label is player-facing: MapPortal composes it into "View sanguophage lair" and
    "Exit sanguophage lair" gizmo/command strings.
  -->
  <MapGeneratorDef>
    <defName>SL_Lair</defName>
    <label>sanguophage lair</label>
    <isUnderground>true</isUnderground>
    <forceCaves>true</forceCaves>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>
    <pocketMapProperties>
      <biome>Underground</biome>
      <temperature>15</temperature>
      <tileMutators>
        <li>UndergroundCave</li>
      </tileMutators>
    </pocketMapProperties>
    <genSteps>
      <li>ElevationFertility</li>
      <li>MutatorPostElevationFertility</li>
      <li>Underground_RocksFromGrid</li>
      <li>Terrain</li>
      <li>MutatorPostTerrain</li>
      <li>RockChunks</li>
      <li>SL_PlaceStairwellExit</li>
      <li>Plants</li>
      <li>MutatorFinal</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

</Defs>
